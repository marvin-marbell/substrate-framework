      "-c",
      "import json,hashlib,zipfile,math\nfrom pathlib import Path\nfrom fractions import Fraction\nroot=Path.cwd()\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\ndef read(n):return json.loads((root/n).read_bytes())\ndef archive_pair(before,after):\n    assert sha(before['path'])==before['sha256'] and sha(after['path'])==after['sha256']\n    with zipfile.ZipFile(before['path']) as a,zipfile.ZipFile(after['path']) as b:\n        assert set(a.namelist())==set(b.namelist())\n        for name in a.namelist():\n            assert a.read(name)==b.read(name)\n            if 'members' in before:assert hashlib.sha256(a.read(name)).hexdigest()==before['members'][name]\n        return {'before_sha256':before['sha256'],'after_sha256':after['sha256'],'equal_members':len(a.namelist())}\ns=read('joined_phi_u1_spatial_linked_corrected_weighted_20261010_receipt.json')\nc=read('joined_phi_u1_spatial_linked_corrected_weighted_consumer_20261010_receipt.json')\nassert s['source_inputs_unchanged']\narchives=[archive_pair(s['preexecution'],s['executed']),archive_pair(c['preexecution'],c['executed'])]\nsp=[]\nfor case in s['cases']:\n    roles=case['charged_role_observations'];g=math.sqrt(case['frozen_G_display']['g0']);V=case['V']\n    active,aux=map(lambda r:float(Fraction(r['onsite_exact'])),roles)\n    w=[(1+math.cos(p)/4)**2/(33/32) for p in case['raw_cell_phi']]\n    O=sum(-8*wi+2*ph for wi,ph in zip(w,case['raw_cell_PH_weighted_integrand']))/len(w)\n    corrected=64*roles[0]['matter_energy']+63*(aux-active)*g*(V//4)*O\n    assert abs(corrected-case['matter_energy'])<1e-7\n    assert abs(corrected-64*roles[0]['matter_energy'])>1\n    assert case['imposed_loop_delta_same_H']>0\n    assert case['complete_H_variance_lower_bound']>0\n    wrong=case['conditional_shared_overlap']['wrong_constant_overlap_repeated_weight']\n    assert wrong>1e6 and abs(case['conditional_shared_overlap']['constant_overlap_weight_once']-1)<1e-12\n    sp.append({'N':case['N'],'role_corrected_energy':case['complete_body_energy_relative_neutral_eigenenergy'],'A1_energy':case['same_H_A_equals_1_control']['complete_body_energy_relative_neutral_eigenenergy'],'imposed_same_H_cost':case['imposed_loop_delta_same_H'],'complete_variance_lower':case['complete_H_variance_lower_bound'],'mass_collapse_rejected':True,'both_nonstationary':True,'replica_overlap_witness_withdrawn':True})\nr=read('joined_phi_u1_bulk_flux_ring_closed_parity_20261010_actual.json')\ne=read('joined_phi_u1_bulk_flux_ring_closed_parity_20261010_natural_exit.json')\nassert e['natural_exit']==0 and e['exit_was_natural'] and e['local_source_input_bytes_unchanged']\nassert sha('joined_phi_u1_bulk_flux_ring_closed_parity_20261010_actual.json')==e['actual_receipt_sha256']\nassert sha(e['preexecution_archive'])==e['preexecution_sha256']\nassert sha(e['actual_executed_source_input_archive'])==e['actual_executed_source_input_archive_sha256']\nwith zipfile.ZipFile(e['preexecution_archive']) as a,zipfile.ZipFile(e['execution_archive']) as wrapper,zipfile.ZipFile(e['actual_executed_source_input_archive']) as b:\n    pm={n.removeprefix('preexecution/') for n in a.namelist()}\n    am={n.removeprefix('executed/') for n in b.namelist() if n.startswith('executed/')}\n    for name,expected in e['preexecution_members_sha256'].items():\n        assert hashlib.sha256(a.read('preexecution/'+name)).hexdigest()==expected\n        assert a.read('preexecution/'+name)==wrapper.read('preexecuted_bytes/'+name)\n    for name in pm & am:assert a.read('preexecution/'+name)==b.read('executed/'+name)\n    assert {n for n in pm-am if not n.startswith('runtime_')}=={'joined_phi_u1_bulk_flux_ring_capsule.py'}\n    assert all(n.startswith('runtime_') for n in am-pm)\n    ring_runtime_delta={'matched_members':len(pm&am),'wrapper_only_members':sorted(pm-am),'child_only_members':sorted(am-pm),'meaning':'Wrapper import graph differs from child __main__ and ZIP encoding imports, not changed scientific source/input bytes.'}\nassert Fraction(r['coefficient_of_positive_oriented_shift_exact'])<0\nassert r['controlled_remainder']['open_analytic_radius']<1\nsharp=read('joined_phi_u1_uniform_sharp_gauss_attempt2_20261010_actual.json')\nassert sharp['sources_unchanged'] and sharp['inputs_unchanged'] and not sharp['campaign_complete']\nfor name,expected in sharp['source_sha256'].items():assert sha(root/name)==expected\nfor name,expected in sharp['input_sha256'].items():assert sha(root/name)==expected\nchecks=read('joined_phi_u1_spatial_linked_corrected_selected_checker_20261010.json')\nassert checks['returncode']==0 and checks['sources_unchanged']\nassert checks['result']['summary']['filesAnalyzed']==2\nfor name,expected in checks['source_sha256'].items():assert sha(root/name)==expected\nresult={'kind':'EXECUTED_FINAL_SCOPED_BULK_SHARP_SPATIAL_PARENT_INTEGRATION','archives':archives,'spatial':sp,'ring_runtime_delta':ring_runtime_delta,'ring_coefficient':r['coefficient_of_positive_oriented_shift'],'ring_physical_one_reached':False,'sharp_new_photon_inference':False,'changed_two_checker':checks['result']['summary'],'campaign_complete':False}\nprint(json.dumps(result,indent=2))\n"
