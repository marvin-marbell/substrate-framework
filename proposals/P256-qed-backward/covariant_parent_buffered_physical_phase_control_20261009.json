  "program_utf8": "import numpy as np,json,math\nfrom scipy.linalg import eigh\na=.01;lo=math.exp(-4*a);A0=np.diag([.98,lo,1.01,.9]);source=np.eye(4)[:,0];unsafe=np.eye(4)[:,1]\nM=np.array([[.3,.5,.2,.1],[.5,-.7,0,0],[.2,0,0,0],[.1,0,0,0.]])\ndef filtered(A,t):\n v,U=eigh(A);mask=(v>=lo)&(v<=1)\n weights=np.zeros(len(v),complex);weights[mask]=np.sqrt(v[mask])*np.exp(1j*t/a*np.log(v[mask]))\n return (U*weights)@U.conj().T,(U*mask)@U.conj().T\nrows=[]\nfor eps in [1e-8,1e-10,1e-12]:\n A1=A0+eps*M;delta=float(np.linalg.norm(A1-A0,2));sep_lower=.98-lo;sep_upper=1-.98\n leakage=delta*math.sqrt(sep_lower**-2+sep_upper**-2)\n for t in [0.,.013,1.,1e6]:\n  F0,P0=filtered(A0,t);F1,P1=filtered(A1,t)\n  actual=float(np.linalg.norm((F1-F0)@source));bad=float(np.linalg.norm((F1-F0)@unsafe))\n  bound=(abs(t/a)*delta/lo+delta/(math.sqrt(lo)+math.sqrt(.98))+leakage)\n  if actual>bound+1e-12: raise ArithmeticError('Buffered physicalphase bound failed')\n  if np.linalg.norm(P1-P0,2)<.99 or bad<.97: raise ArithmeticError('Globalthreshold/unsafe source adverse not reached')\n  rows.append(dict(epsilon=eps,physical_time=t,normalized_operator_delta=delta,reference_band_lower=lo,reference_source_energy=-math.log(.98)/a,source_intertwining_phase_error=actual,conditional_buffered_upper=bound,global_projector_delta=float(np.linalg.norm(P1-P0,2)),unsafe_threshold_source_phase_error=bad))\nprint(json.dumps(dict(spacing=a,physical_Pe_window=[0,4],global_charged_normalized_K_max=1.01,source_reference_eigenvalue=.98,rows=rows)))\n",
