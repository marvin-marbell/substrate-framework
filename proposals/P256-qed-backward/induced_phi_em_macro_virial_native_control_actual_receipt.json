tter,missing_Pi_error=2*base['primitive_electric'],charged_profiles_one_two_link_energy=partial,\n    exact_gauss_dilation_variance=(2*native['V']+1)/2,Robertson_energy_variance_per_V_lower=force**2/(2*(2*native['V']+1)*native['V']),\n    source_hashes_at_import={name:hashlib.sha256(data).hexdigest() for name,data in IMPORT_BYTES.items()},probe_source_bytes_utf8=PROBE_BYTES.decode())\nrecord['input_sha256']=hashlib.sha256(json.dumps(record['input_descriptor'],sort_keys=True).encode()).hexdigest()\nif record['derivative_error']>abs(force)*1e-7 or record['missing_Pi_error']<100:raise ArithmeticError(record)\n(root/'induced_phi_em_macro_virial_native_control_actual_receipt.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint(json.dumps({key:value for key,value in record.items() if key not in ('probe_source_bytes_utf8','source_hashes_at_import')},indent=2))\n",
