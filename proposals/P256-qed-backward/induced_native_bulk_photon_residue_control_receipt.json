    "own_bytes_utf8": "\"\"\"Measure operator positive-frequency residues; do not confuse omega\u00b2 poles.\"\"\"\nfrom __future__ import annotations\nimport os\nfor key in ('OPENBLAS_NUM_THREADS','OMP_NUM_THREADS','MKL_NUM_THREADS'):os.environ[key]='1'\nimport hashlib,importlib.util,json,sys,time\nfrom pathlib import Path\nfrom typing import Any\nimport numpy as np\nP=Path('/home/administrator/substrate-222/proposals/P256-qed-backward');GREEN=Path('/tmp/induced-native-bulk-photon-green.py');GH='3e905f9f4941b19658bf90383236546faafaa269ea80a65d2d828232b8fa2440'\n\n\ndef main()->None:\n    start=time.monotonic();own=Path(__file__).read_bytes()\n    if hashlib.sha256(GREEN.read_bytes()).hexdigest()!=GH:raise RuntimeError('Actual bulk Green changed')\n    sp=importlib.util.spec_from_file_location('actual_residue_bulk_Green',GREEN)\n    if sp is None or sp.loader is None:raise RuntimeError('Actual Green source unavailable')\n    g:Any=importlib.util.module_from_spec(sp);sys.modules[sp.name]=g;sp.loader.exec_module(g);supplier=g.NativeBulkPhotonGreen(8);rows=[];worst=0.\n    for q in (np.asarray([.05,0.,0.]),np.asarray([.03,.04,.02])):\n        block=supplier.block(q);mode=block.mode();omega=mode['omega'];expected=np.zeros((3,3),complex);wrong_x=np.zeros((3,3),complex);wrong_volume=np.zeros((3,3),complex);weights=[]\n        for pole in mode['two_polarizations']:\n            w=pole['omega'];direction=block.transverse.T@np.asarray(pole['polarization']);chi,d=block.density_inverse(complex(w,0.));scalar=-w*(direction@d)/chi;pol=np.concatenate((direction,[scalar]));projector=np.outer(pol,pol.conj());frequency_weight=pole['residue']/(2*w*supplier.cfg.a**3);expected+=frequency_weight*projector;wrong_x+=pole['residue']/supplier.cfg.a**3*projector;wrong_volume+=pole['residue']/(2*w)*projector;weights.append({'actual_omega':w,'actual_density_omega_squared_residue_Z':pole['residue'],'actual_site_positive_frequency_operator_weight':frequency_weight,'actual_complexq_physical_operator_polarization':pol})\n        probes=[]\n        for eta_relative in (1e-3,1e-4,1e-5):\n            z=complex(omega,omega*eta_relative);observed=(z-omega)*block.retarded(z);error=float(np.max(abs(observed-expected))/np.max(abs(expected)));probes.append({'actual_z':z,'actual_measured_positive_frequency_residue':observed,'actual_relative_error':error})\n        worst=max(worst,probes[-1]['actual_relative_error']);bound=2*supplier.cfg.m*np.sqrt(supplier.cfg.g0);rows.append({'actual_qphysical':q,'actual_individual_mode_weights':weights,'actual_degenerate_frequency_splitting':abs(mode['two_polarizations'][1]['omega']-mode['two_polarizations'][0]['omega']),'actual_measured_residue_probes':probes,'actual_expected_positive_frequency_residue_sum':expected,'actual_wrong_omega_squared_as_one_frequency_residue_relative_defect':float(np.max(abs(wrong_x-expected))/np.max(abs(expected))),'actual_wrong_omitted_site_volume_normalization_relative_defect':float(np.max(abs(wrong_volume-expected))/np.max(abs(expected))),'analytic_primitive_pair_energy_lower_bound_at_actual_binary_input':bound,'actual_IR_frequency_divided_by_structural_lower_bound':omega/bound})\n    if worst>1e-4:raise ArithmeticError(f'Actual measured photon positive-frequency residue unresolved: {worst}')\n    supplier.s.assert_frozen();report={'status':'natural_exit_actual_site_photon_operator_residue_convention_measured','assigned_execution_epoch':g.ASSIGNED,'actual_rows':rows,'actual_final_measured_positive_frequency_residue_error':worst,'contract':{'mode_residue':'Existingmode.residue = Z_omega\u00b2 = [\u2202M/\u2202(omega\u00b2)]^-1. mode.omega averagesT1/T2; individualfrequenciesin two_polarizations.','physical_site_positive_frequency_operator_amplitudes':'b b\u2020 = Z_omega\u00b2/(2 omega a\u00b3) * pol_total pol_total\u2020 forcomplex+qO=(A_T1,A_T2,phi), pol_total=(T^TpolA,-omega dTpolA/chi). Degeneratepolarizationssum; instantaneousscalarC haszeroresidue.','matter_vertex':'J_A=a JTheta, +rho phi; no extra2omega/a-volume flavourcopy/hiddenfixedc factor. NativecomplexqcommutatorFouriernormalizationmatchesper-siteinteractionsupplier, notcontinuumvolume-normalizedoperator.','continuum_scope':'HereboundedIRfrequencies<2m\u221ag0 ofactualpositivequarticWilsonmassband; floatingnumbersNOToutwardintervalenclosure. UVquadraturephotonpolesfalsifiedby58a5actualcontinuousPHshells, notadmittedasstablephotons.'},'scope':['Measured(z-omega)G(z), fulluncompressedcurrent/contact/scalarresponse, atthreeactualupperplaneetas. Finaletaerrorconverges; wrongomega\u00b2residueandmissing1/a\u00b3 failbylargeexplicitobservabledefects.','PrimitiveE(p)>=m\u221ag0 followsactualpositivebaremass+quarticWilsonform atgivenmetric/r>0; sameactive1+aux63 masses. No speedmatch/newmass/no exactfulltheorypole/chargedline/source/Thomson/Compton claim. Originalfrozenbytesunchanged.'],'same_interacting_source_return_sha256':supplier.parent.CURVATURE_HASH,'provenance':{'own_sha256':hashlib.sha256(own).hexdigest(),'own_bytes_utf8':own.decode(),'actual_bulk_Green_source_sha256':GH,'primitive_source_hashes':supplier.s.primitives.SOURCE_HASHES},'elapsed_seconds':time.monotonic()-start}\n    if Path(__file__).read_bytes()!=own or hashlib.sha256(GREEN.read_bytes()).hexdigest()!=GH:raise RuntimeError('Actual residue input changed')\n    out=P/'induced_native_bulk_photon_residue_control_receipt.json';out.write_text(json.dumps(supplier.s.primitives.packed(report),indent=2,allow_nan=False)+'\\n');print(json.dumps(supplier.s.primitives.packed({'error':worst,'rows':[{'q':r['actual_qphysical'],'weights':r['actual_individual_mode_weights'],'errors':[p['actual_relative_error'] for p in r['actual_measured_residue_probes']],'wrong_x':r['actual_wrong_omega_squared_as_one_frequency_residue_relative_defect'],'wrong_volume':r['actual_wrong_omitted_site_volume_normalization_relative_defect'],'IR_to_pairbound':r['actual_IR_frequency_divided_by_structural_lower_bound']} for r in rows]}),indent=2),flush=True);print('Natural exit',out