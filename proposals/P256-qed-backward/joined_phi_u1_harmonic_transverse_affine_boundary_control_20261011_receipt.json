    "script": "\nimport json,itertools\nfrom fractions import Fraction as F\nimport numpy as np\nimport bulk_electric_phase_consumer as native\nfrom pathlib import Path\nroot=Path.cwd()\nrows=[]\nfor n in [4,6,8]:\n    box=native.IntegerBox(n)\n    for x0,axis,length,qa in itertools.product([0,1],range(3),[1,2],[-1,1]):\n        start=(x0,0,0);end=box.step(start,axis,length)\n        ca=(start[0]//2,start[1],start[2]);cb=(end[0]//2,end[1],end[2])\n        if ca==cb:continue\n        edgeA=3*box.index[(2*ca[0],ca[1],ca[2])]\n        edgeB=3*box.index[(2*cb[0],cb[1],cb[2])]\n        inc=box.path(start,axis,length)\n        shift=-qa*inc\n        expected=np.zeros(box.volume,dtype=np.int64);expected[box.index[start]]=qa;expected[box.index[end]]=-qa\n        assert np.array_equal(-box.divergence(shift),expected)\n        da=qa*F(1 if start[0]%2==0 else -1,2)\n        db=-qa*F(1 if end[0]%2==0 else -1,2)\n        ua=-da-F(int(shift[edgeA]));ub=-db-F(int(shift[edgeB]))\n        # Entire source has unchanged internal E when primitive path does\n        # not use either matching edge, not when endpoint positions are ignored.\n        correct=64*(F(int(shift[edgeA]))**2+F(int(shift[edgeB]))**2)\n        old=64*((da+F(qa,2))**2+(db+F(qa,2))**2)\n        rows.append({'N':n,'start':start,'end':end,'axis':axis,'length':length,'qa':qa,'sites':[start[0]%2,end[0]%2],'internal_shift':[int(shift[edgeA]),int(shift[edgeB])],'affine_u':[str(ua),str(ub)],'actual_internal_HE_increment_Rzero':str(correct),'old_common_u_internal_HE_increment_Rzero':str(old),'common_u_correct':ua==ub==F(qa,2)})\nassert all(r['common_u_correct'] for r in rows if r['axis']==0)\nassert all(not r['common_u_correct'] for r in rows if r['axis']!=0)\n# A legal signed-CAR state reaches the perpendicular wrong case under an\n# ACTUAL nonzero frozen Phi hopping entry, not an invented source matrix.\nprofile=json.loads((root/'charged_first_shell_actual04_20261011_receipt.json').read_text())['all64_boundary']['roles'][0]\npath=next(p for p in profile['paths'] if p['axis']==1 and p['length']==1)\nM=path['matrix_exact']\nr,c=next((r,c) for r,c in itertools.product(range(4),repeat=2) if r!=c and any(F(z) for z in M[r][c]))\noccupied={c,next(i for i in range(4) if i not in {r,c})}\nmask=sum(1<<(4*site+i) for site in range(4) for i in occupied)\ntransition=native.car(mask,4+r,12+c);assert transition is not None\nchanged,sign=transition\ncounts=[sum((changed>>(4*site+i))%2 for i in range(4)) for site in range(4)]\nassert counts==[2,3,2,1]\nra=F(counts[0]-counts[1],2);rb=F(counts[2]-counts[3],2)\nassert ra==-F(1,2) and rb==F(1,2)\ncorrect=64*((ra+F(1,2))**2+(rb-F(1,2))**2)+64\nwrong=64*((ra+F(1,2))**2+(rb+F(1,2))**2)+64\nassert correct==64 and wrong==128\nprint(json.dumps({'kind':'LITERAL_NATIVE_MATCHING_GEOMETRY_AFFINE_BOUNDARY_CONTROL','rows':rows,'signed_CAR_actual_axis1_wrongcase':{'occupied_colors':sorted(occupied),'create_color':r,'annihilate_color':c,'actual_nonzero_matrix_entry':M[r][c],'CAR_sign':sign,'counts_after':counts,'correct_HE':'64','wrong_common_u_HE':'128'},'axis0_line_positive_control':True,'transverse_common_u_adoption_rejected':True,'source_G_and_charged_lower_unaffected':True,'selected_ground_expectation_or_variance':False,'global_no_go_or_phase':False}))\n",
