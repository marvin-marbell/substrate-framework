    "command": [
      "/home/administrator/substrate-framework/.venv/bin/python",
      "-c",
      "import itertools,json,numpy as np\nrng=np.random.default_rng(2221011)\nbasis=[sum(1<<j for j in a)+sum(1<<(4+j) for j in b) for a in itertools.combinations(range(4),2) for b in itertools.combinations(range(4),2)]\nindex={m:i for i,m in enumerate(basis)}\nseed=sum(1<<j for j in [0,1,4,5]);v0=index[seed]\ndef dg(h,copy):\n    out=np.zeros((36,36),complex)\n    for col,mask in enumerate(basis):\n        for j in range(4):\n            aj=4*copy+j\n            if not mask>>aj&1:continue\n            s1=(-1)**((mask&((1<<aj)-1)).bit_count());m=mask^(1<<aj)\n            for i in range(4):\n                ci=4*copy+i\n                if m>>ci&1:continue\n                s2=(-1)**((m&((1<<ci)-1)).bit_count());target=m|(1<<ci)\n                out[index[target],col]+=s1*s2*h[i,j]\n    return out\ndef herm():\n    z=rng.normal(size=(4,4))+1j*rng.normal(size=(4,4));return (z+z.conj().T)/4\nRs=[herm() for _ in range(3)];Ts=[herm() for _ in range(3)]\ncommon=herm(); onsite=herm();Ms=[common+.2*onsite,common+1.1*onsite]\ng=64;reports=[]\nfor label,zero_mean in [('generic_Berry',False),('mean_zero',True)]:\n    RR=[r.copy() for r in Rs];TT=[t.copy() for t in Ts]\n    if zero_mean:\n        for r,t in zip(RR,TT):\n            r[:2,:2]-=np.eye(2)*np.trace(r[:2,:2])/2\n            t[:2,:2]-=np.eye(2)*np.trace(t[:2,:2])/2\n    full=sum((dg(m,c) for c,m in enumerate(Ms)),np.zeros((36,36),complex))\n    wrong_no_cross=full.copy()\n    for r,t in zip(RR,TT):\n        xs=[dg(r,c) for c in range(2)];ys=[dg(t,c) for c in range(2)];X=xs[0]+xs[1];Y=ys[0]+ys[1]\n        full+=g*(X@X-1j*Y)\n        wrong_no_cross+=g*(sum(x@x for x in xs)-1j*Y)\n    hv=full[:,v0];actual=float(np.vdot(hv,hv).real)\n    zero=sum(np.trace(m[:2,:2]) for m in Ms)\n    one=[m[2:,:2].copy() for m in Ms]\n    for r,t in zip(RR,TT):\n        K=r[2:,:2];mean=2*np.trace(r[:2,:2])\n        zero+=g*(mean**2+2*np.vdot(K,K).real-1j*2*np.trace(t[:2,:2]))\n        delta=g*(2*mean*K+r[2:,2:]@K-K@r[:2,:2]-1j*t[2:,:2])\n        one=[a+delta for a in one]\n    double=0j\n    for r in RR:\n        for s in RR:\n            Z=r[2:,:2].conj().T@s[2:,:2]\n            double+=2*g*g*((2*np.trace(Z))**2-2*np.trace(Z@Z))\n    assert abs(double.imag)<1e-8\n    formula=float(abs(zero)**2+sum(np.vdot(a,a).real for a in one)+double.real)\n    relative=abs(actual-formula)/max(1,actual);assert relative<2e-13\n    grade={n:sum(abs(hv[i])**2 for i,m in enumerate(basis) if (m&sum(1<<j for j in [2,3,6,7])).bit_count()==n) for n in range(5)}\n    assert abs(grade[0]-abs(zero)**2)<2e-11*max(1,actual)\n    assert abs(grade[1]-sum(np.vdot(a,a).real for a in one))<2e-11*max(1,actual)\n    assert abs(grade[2]-double.real)<2e-11*max(1,actual)\n    assert grade[3]+grade[4]==0\n    dropped=float(np.vdot(wrong_no_cross[:,v0],wrong_no_cross[:,v0]).real)\n    assert abs(dropped-actual)>1\n    average=(Ms[0]+Ms[1])/2\n    wrong_average=full+dg(average-Ms[0],0)+dg(average-Ms[1],1)\n    wrong_mean=float(np.vdot(wrong_average[:,v0],wrong_average[:,v0]).real)\n    assert abs(wrong_average[v0,v0]-full[v0,v0])<1e-12\n    assert abs(wrong_mean-actual)>1e-3\n    php=float(grade[0]+grade[1]);assert actual-php>1\n    reports.append({'case':label,'complete_action_norm_squared':actual,'Gaussian_012PH_formula':formula,'relative_defect':relative,'grade_norm_squared':grade,'wrong_drop_crosscopy':dropped,'wrong_average_roles':wrong_mean,'wrong_averaged_role_energy_matches':True,'wrong_PHP_squared':php})\nprint(json.dumps({'kind':'INDEPENDENT_COMPLETE_GAUSSIAN_FRAME_ACTION_DENSE_CANONICAL_CAR_METHOD_CONTROL','inputs':{'copies':2,'orbitals_per_copy':4,'particles_per_copy':2,'seed_occupied':[0,1,4,5],'seed':2221011,'g':64,'state_dimension':36,'numpy_version':np.__version__,'generic_R_real_imag':[np.stack((r.real,r.imag),axis=-1).tolist() for r in Rs],'generic_T_real_imag':[np.stack((t.real,t.imag),axis=-1).tolist() for t in Ts],'role_M_real_imag':[np.stack((m.real,m.imag),axis=-1).tolist() for m in Ms]},'derivation':'E\u00b2 U Psi0 = U[(dGamma R)\u00b2-i dGamma Rprime]Psi0. Full action has exactly0/1/2PH relative to this Gaussian frame, not a truncation of a nonGaussian source. Distinct role matrices, common generators, trace/Berry terms retained.','reports':reports,'actual_N4_law':False,'stationary_or_photon_claim':False},indent=2))\n"
