  "captured_governor": "efd1a1f937e92f04704903209971b6fba3d24da85bf8e1dce0e4dc91bc2d3aba",
  "inline_script": "import json, sys\nfrom pathlib import Path\nfrom collections import Counter\nfrom fractions import Fraction\np=Path(sys.argv[1]); data=json.loads(p.read_text()); N=4; V=N**3\nsites=[(x,y,z) for x in range(N) for y in range(N) for z in range(N)]\nindex={x:i for i,x in enumerate(sites)}\ndef classify(pairs):\n    k=dict(pairs); div=[0]*V; totals=[0]*3\n    for e,v in k.items():\n        i,mu=divmod(e,3); x=sites[i]; y=list(x); y[mu]=(y[mu]+1)%N; j=index[tuple(y)]\n        div[i]+=v; div[j]-=v; totals[mu]+=v\n    assert not any(div)\n    assert all(t%N==0 for t in totals)\n    w=tuple(t//N for t in totals)\n    norm=sum(v*v for v in k.values())\n    harmonic=sum(Fraction(t*t,V) for t in totals)\n    return w,Fraction(norm),harmonic\nmodes=[r for r in data['all_Laurent_coefficients'] if r['integer192_character'] and (r['amplitude'][0]!=0 or r['amplitude'][1]!=0)]\nclasses=Counter(); rows=[]\nfor r in modes:\n    pairs=r['integer192_character']; w,n,h=classify(pairs)\n    axes={e%3 for e,v in pairs}; assert len(axes)==1 and len(pairs)==N\n    mu=next(iter(axes)); weights={v for e,v in pairs}; assert len(weights)==1 and next(iter(weights)) in (-1,1)\n    coords=[sites[e//3] for e,v in pairs]\n    assert sorted(x[mu] for x in coords)==list(range(N))\n    assert all(len({x[a] for x in coords})==1 for a in range(3) if a!=mu)\n    assert sum(abs(v) for v in w)==1 and n==4 and h==Fraction(1,4)\n    classes[w]+=1; rows.append(dict(character=pairs,winding=list(w),norm_squared=str(n),harmonic_norm_squared=str(h),nonharmonic_norm_squared=str(n-h)))\nassert len(modes)==96 and all(n==16 for n in classes.values())\nsquare=[[0,1],[49,1],[12,-1],[1,-1]]\nw,n,h=classify(square); assert w==(0,0,0) and n==4 and h==0\nout=dict(scope='EXACT_INTEGER_TOPOLOGY_OF_RETAINED_N4_LAURENT_MODES_NOT_LARGE_VOLUME_PHYSICS',nonconstant_modes=len(modes),zero_homology_nonconstant_modes=sum(count for wind,count in classes.items() if wind==(0,0,0)),straight_unit_winding_modes=len(rows),homology_classes={str(k):v for k,v in sorted(classes.items())},known_contractible_plaquette_positive_control=dict(character=square,winding=list(w),norm_squared=str(n)),wrong_pure_harmonic_identification_rejected=True,mode_norm_squared='4',harmonic_piece='1/4',nonharmonic_piece='15/4',rows=rows,conclusion='All observed g coefficients are N4 winding Wilson lines, not a witnessed local contractible plaquette sector. They still have nonharmonic components and remain actual correlated observables. No N>4 vanishing, phase, stiffness or pole claim follows.')\nprint(json.dumps(out))\n",
