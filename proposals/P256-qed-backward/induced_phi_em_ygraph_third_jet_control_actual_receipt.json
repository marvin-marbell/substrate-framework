  "probe_source_bytes_utf8": "import hashlib,json,sys\nfrom pathlib import Path\nPROBE_BYTES=Path(__file__).read_bytes()\nsys.path.insert(0,'/home/administrator/substrate-222/proposals/P256-qed-backward')\nimport numpy as np\nfrom scipy.linalg import solve_sylvester\nfrom induced_phi_em_ygraph_weak_domain import SOURCE_BYTES\nfrom induced_reference_electric_graph import graph_state,to_spin_basis\nfrom induced_phi_em_gaussian_variational import build_native\nroot=Path('/home/administrator/substrate-222/proposals/P256-qed-backward');meanraw=(root/'induced_phi_ir_mean_certificate_normal_transfer_final_receipt.json').read_bytes();dataraw=(root/'induced_phi_em_ygraph_weak_domain_actual_receipt.json').read_bytes();data=json.loads(dataraw);native=build_native(json.loads(meanraw),2);theta=native['Q']@np.linspace(-.3,.41,native['M']);direction=native['Q'][:,6];rows=[]\nfor profile,caps in zip(native['Pprofiles'],data['uniform_Ygraph_jets']):\n    state=graph_state(native,profile,theta,section=False);Y=state['Y'];n=len(Y);identity=np.eye(n);B=identity+Y@Y;v,U=np.linalg.eigh(B);T=(U*np.sqrt(v))@U.conj().T;A=(U/np.sqrt(v))@U.conj().T;jets=[]\n    for order in (1,2,3):\n        hd=np.zeros((4*native['V'],4*native['V']),complex)\n        for path in profile['paths']:\n            line=sum(direction[e] for e in path['edges']);phase=np.exp(1j*sum(theta[e] for e in path['edges']));block=(1j*line)**order*phase*path['hop'];x=path['source'];y=path['target'];hd[4*x:4*x+4,4*y:4*y+4]+=block;hd[4*y:4*y+4,4*x:4*x+4]+=block.conj().T\n        hb=to_spin_basis(hd,state['B']);jets.append(-1j*hb[np.ix_(state['pp'],state['nn'])]/state['denominator'])\n    Y1,Y2,Y3=jets;B1=Y1@Y+Y@Y1;B2=Y2@Y+Y@Y2+2*Y1@Y1;B3=Y3@Y+Y@Y3+3*(Y2@Y1+Y1@Y2)\n    T1=solve_sylvester(T,T,B1);T2=solve_sylvester(T,T,B2-2*T1@T1);T3=solve_sylvester(T,T,B3-3*(T1@T2+T2@T1));A1=-A@T1@A;A2=2*A@T1@A@T1@A-A@T2@A;A3=-6*A@T1@A@T1@A@T1@A+3*A@T2@A@T1@A+3*A@T1@A@T2@A-A@T3@A\n    W3=np.vstack((-1j*(Y3@A+3*Y2@A1+3*Y1@A2+Y@A3),A3));wrong=np.vstack((-1j*(Y3@A+3*Y2@A1+3*Y1@A2),np.zeros_like(A3)))\n    def W(t):\n        y=graph_state(native,profile,theta+t*direction,section=False)['Y'];v,u=np.linalg.eigh(identity+y@y);a=(u/np.sqrt(v))@u.conj().T;return np.vstack((-1j*y@a,a))\n    step=.002;difference=(W(2*step)-2*W(step)+2*W(-step)-W(-2*step))/(2*step**3);error=float(np.linalg.norm(difference-W3,2));defect=float(np.linalg.norm(wrong-W3,2));ynorms=[float(np.linalg.norm(j,2)) for j in jets];anorms=[float(np.linalg.norm(j,2)) for j in (A1,A2,A3)];wnorm=float(np.linalg.norm(W3,2));guard=[float(caps['inverse_square_root_jet_caps'][k]['decimal_display']) for k in range(3)]\n    rows.append(dict(load=profile['load'],literal_native_Y_first_second_third_norms=ynorms,actual_resolvent_square_root_first_second_third_norms=anorms,uniform_macro_A_jet_caps=guard,literal_W_third_norm=wnorm,independent_third_difference_error=error,wrong_drop_inverse_square_root_third_defect=defect,canonical_W_orthonormal_error=float(np.linalg.norm(W(0).conj().T@W(0)-identity,2))))\n    if error>1e-5 or defect<1e-5 or any(actual>cap for actual,cap in zip(anorms,guard)):raise ArithmeticError(rows[-1])\nrecord=dict(input_descriptor=dict(mean_sha256=hashlib.sha256(meanraw).hexdigest(),actual_Y_domain_receipt_sha256=hashlib.sha256(dataraw).hexdigest(),N=2,a=native['a'],UE=native['UE'],theta=theta.tolist(),direction=direction.tolist(),step=.002,probe_sha256=hashlib.sha256(PROBE_BYTES).hexdigest()),rows=rows,scope='LiteralactualphysicalPeierls derivatives1/2/3 + SylvesterBsqrt jets/canonicalYray, independentthirdfiniteDifference andadverseA3drop; native2operatorcontrol NOTmacro/H2Phi/domain substitute.',source_hashes_at_import={name:hashlib.sha256(raw).hexdigest() for name,raw in SOURCE_BYTES.items()},probe_source_bytes_utf8=PROBE_BYTES.decode())\nrecord['input_sha256']=hashlib.sha256(json.dumps(record['input_descriptor'],sort_keys=True).encode()).hexdigest();(root/'induced_phi_em_ygraph_third_jet_control_actual_receipt.json').write_text(json.dum