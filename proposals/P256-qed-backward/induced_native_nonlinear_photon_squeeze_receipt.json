ontact_energy'];fixed=blocks['actual_C_energy']+blocks['actual_PH_excitation_cost'];H0=phase['actual_factorized_fixedCAR_and_photon_marginal_diagnostic']['actual_frozenCAR_H0'];onsite=H0-float(np.sum(coefficients))\n    def evaluate(scale:float)->dict[str,Any]:\n        if scale<=0:raise ValueError('Canonical squeeze scale must be positive')\n        d=np.exp(-variances*scale*scale/2);CAR=onsite+float(coefficients@d);current=float(scale*(J@d));kin=Pi/(scale*scale);energy=CAR+current+kin+fixed;derivative=-2*Pi/scale**3-float(scale*(coefficients*variances)@d)+float((J*(1-variances*scale*scale))@d);second=6*Pi/scale**4+float((coefficients*(-variances+variances**2*scale**2))@d)+float((J*(-3*variances*scale+variances**2*scale**3))@d);return {'actual_canonical_squeeze_scale':scale,'actual_same_nonlinear_H_expectation':energy,'actual_energy_first_derivative':derivative,'actual_energy_second_derivative':second,'actual_frozenCAR_mean_allorder_expectation':CAR,'actual_joint_linearPH_sine_expectation':current,'actual_Pi_expectation':kin,'actual_unchanged_C_and_PH_expectation':fixed,'actual_path_variances':variances*scale**2,'actual_path_characteristics':d}\n    quadratic_derivative=-2*Pi+2*CA+float(np.sum(J));return {'coefficients':coefficients,'variances':variances,'currents':J,'Pi':Pi,'fixed':fixed,'H0':H0,'onsite':onsite,'quadratic_energy_derivative_at1':quadratic_derivative,'evaluate':evaluate}\n\n\ndef main()->None:\n    started=time.monotonic();own=Path(__file__).read_bytes();phase,joint,pb,jb=inputs();model=state_functionals(phase,joint);evaluate=model['evaluate'];base=evaluate(1.);left,right=.5,1.5;leftd=evaluate(left)['actual_energy_first_derivative'];rightd=evaluate(right)['actual_energy_first_derivative']\n    if not leftd<0<rightd:raise ArithmeticError('Actual photon-squeeze local stationary bracket unresolved')\n    initial=[left,right];iterations=[]\n    for n in range(52):\n        mid=(left+right)/2;value=evaluate(mid)['actual_energy_first_derivative'];iteratio